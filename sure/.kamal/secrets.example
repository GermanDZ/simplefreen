# Copy to .kamal/secrets and fill in. `.kamal/secrets` is git-ignored
# by the simplefreen repo (`sure/.kamal/secrets`).
#
# Mint values with:
#   SECRET_KEY_BASE:   openssl rand -hex 64
#   POSTGRES_PASSWORD: openssl rand -base64 32
#
# GHCR_TOKEN: reuse the same PAT you use for simplefreen — needs
# read:packages + write:packages on your GitHub account. (You can
# copy the exact value from ../../.kamal/secrets.)

KAMAL_REGISTRY_USERNAME=your-github-user
GHCR_TOKEN=

SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Optional — enables Sure's AI-assisted features (chat, rules). Costs
# apply on your OpenAI account. Leave blank to disable AI features.
OPENAI_ACCESS_TOKEN=

# Wire these up when you need email / WebAuthn / S3 storage. Match the
# `secret:` block in config/deploy.yml when you add them. Full env
# contract is in ../../sure-finances/.env.example.
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS_ENABLED=true
# EMAIL_SENDER=
# WEBAUTHN_RP_ID=sure.example.com
# WEBAUTHN_ALLOWED_ORIGINS=https://sure.example.com
