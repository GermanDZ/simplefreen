# Copy to .kamal/secrets (gitignored) and fill in. Kamal reads this
# file via `secrets_path: .kamal/secrets` in config/deploy.yml and
# substitutes the referenced names into the env.secret + registry
# blocks.
#
# Mint the three application secrets once:
#   ruby -rsecurerandom -rbase64 \
#     -e 'puts Base64.strict_encode64(SecureRandom.random_bytes(32))'   # → SIMPLEFREEN_SECRETS_KEY
#   ruby -rsecurerandom -e 'puts SecureRandom.base64(24)'                # → SIMPLEFREEN_ADMIN_PASSWORD
#   openssl rand -hex 32                                                  # → FREENTONIC_INVOKE_TOKEN
#
# Losing SIMPLEFREEN_SECRETS_KEY = every encrypted bank credential on
# disk is unrecoverable. Back it up out of band.

KAMAL_REGISTRY_USERNAME=your-github-user
GHCR_TOKEN=ghp_replace_me

SIMPLEFREEN_SECRETS_KEY=base64_32_bytes_here
SIMPLEFREEN_ADMIN_PASSWORD=admin_password_here
FREENTONIC_INVOKE_TOKEN=hex_32_bytes_here
