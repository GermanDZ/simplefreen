#!/usr/bin/env bash
# bin/backup-sure — back up the prod sure-finances Postgres database.
#
# Thin wrapper around sure/bin/backup-db so you can run it from
# anywhere without cd'ing into sure/. All args are forwarded.
#
# Examples:
#   bin/backup-sure                   # backups/sure-<utc-stamp>.dump
#   bin/backup-sure before-upgrade    # backups/sure-<utc-stamp>-before-upgrade.dump

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/../sure/bin/backup-db" "$@"
